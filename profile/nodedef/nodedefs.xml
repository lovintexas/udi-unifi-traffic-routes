<?xml version="1.0" encoding="UTF-8"?>
<nodeDefs>

  <nodeDef id="controller" nls="controller">
    <sts>
      <st id="ST" editor="bool"/>
    </sts>
    <cmds>
      <sends>
        <cmd id="QUERY"/>
      </sends>
    </cmds>
  </nodeDef>

  <nodeDef id="unifiroute" nls="unifiroute">
    <sts>
      <st id="ST" editor="bool"/>
    </sts>
    <cmds>
      <accepts>
        <cmd id="DON"/>
        <cmd id="DOF"/>
        <cmd id="QUERY"/>
      </accepts>
    </cmds>
  </nodeDef>

  <nodeDef id="unificlient" nls="unificlient">
    <sts>
      <st id="ST" editor="bool"/>
      <st id="GV1" editor="bool"/>
    </sts>
    <cmds>
      <accepts>
        <cmd id="BLOCK"/>
        <cmd id="UNBLOCK"/>
        <cmd id="QUERY"/>
      </accepts>
    </cmds>
  </nodeDef>

  <nodeDef id="unififirewall" nls="unififirewall">
    <sts>
      <st id="ST" editor="bool"/>
    </sts>
    <cmds>
      <accepts>
        <cmd id="DON"/>
        <cmd id="DOF"/>
        <cmd id="QUERY"/>
      </accepts>
    </cmds>
  </nodeDef>

  <nodeDef id="unifiport" nls="unifiport">
    <sts>
      <st id="ST" editor="bool"/>
      <st id="GV1" editor="portspeed"/>
    </sts>
  </nodeDef>

  <nodeDef id="unifipoeport" nls="unifipoeport">
    <sts>
      <st id="ST" editor="bool"/>
      <st id="GV1" editor="portspeed"/>
      <st id="GV2" editor="poestatus"/>
      <st id="GV3" editor="poepower"/>
    </sts>
    <cmds>
      <accepts>
        <cmd id="POEON"/>
        <cmd id="POEOFF"/>
        <cmd id="POECYCLE"/>
      </accepts>
    </cmds>
  </nodeDef>

</nodeDefs>
